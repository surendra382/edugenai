DATABASE_URL=sqlite:///./data/app.db
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
KNOWLEDGE_BASE_DIR=./knowledge_base
MAX_UPLOAD_SIZE_MB=20
# LLM provider — any OpenAI-compatible chat/completions API works here
# (Groq, OpenAI, OpenRouter, Together, Fireworks, a local Ollama/vLLM server
# in OpenAI-compat mode, etc.). Switch providers by changing these three
# values only — no code changes needed.
#
# Groq (default):
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
#
# OpenAI:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
#
# OpenRouter (proxies many models/providers behind one OpenAI-compatible API):
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openrouter/auto
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Logging — JSON lines written to LOG_DIR/app.log (rotating) and stdout.
# Set LOG_LEVEL=DEBUG to include full retrieved chunk text in retrieval logs
# (INFO only logs a truncated preview). Set LOG_JSON=false for plain-text
# console output during local dev.
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON=true
